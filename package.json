{
  "name": "@snarkipus/opencode-beads",
  "version": "0.10.0",
  "type": "module",
  "description": "A maintained OpenCode V2 integration for the Beads issue tracker: bd prime context injection with a schema-migration guard, and a bounded task agent.",
  "author": "Matt Jackson",
  "contributors": [
    {
      "name": "Josh Thomas",
      "url": "https://github.com/joshuadavidthomas"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snarkipus/opencode-beads.git"
  },
  "homepage": "https://github.com/snarkipus/opencode-beads#readme",
  "bugs": {
    "url": "https://github.com/snarkipus/opencode-beads/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "plugin",
    "beads",
    "agent",
    "ai"
  ],
  "main": "./src/plugin.ts",
  "types": "./src/plugin.ts",
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "import": "./src/plugin.ts"
    },
    "./server": {
      "types": "./src/plugin.ts",
      "import": "./src/plugin.ts"
    }
  },
  "files": [
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "test:docs": "bun test tests/docs.test.ts",
    "test:package": "bun scripts/test-package.ts",
    "test:provenance": "bun test tests/provenance.test.ts",
    "test:release": "bun test tests/release.test.ts",
    "test:vendor": "bun scripts/validate-vendor.ts vendor",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.26 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@types/bun": "1.3.4",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  }
}
